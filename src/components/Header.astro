---
import { existsSync } from 'node:fs';
import site from '../data/site.json';
import Chat from './Chat.astro';
const nav = [
  { href: '/tseny', text: 'Цены' },
  { href: '/#uslugi', text: 'Услуги' },
  { href: '/#ploshchadki', text: 'Площадки' },
  { href: '/#kalkulyator', text: 'Калькулятор' },
  { href: '/about', text: 'О компании' },
];
const logo = existsSync('public/images/logo3.svg') ? '/images/logo3.svg' : null;
---
<header class="head">
  <div class="topline">
    <div class="wrap topline__in">
      <a class="topline__phone" href={site.phone.href} data-goal="phone">{site.phone.text}</a>
      <span class="topline__open"><i class="dot" aria-hidden="true"></i>Работаем круглосуточно</span>
      <Chat variant="dark" />
      <a class="topline__link" href="/#ploshchadki">Площадки</a>
      <button class="btn btn--small btn--line-light" type="button" data-open="order">Заказать вывоз</button>
    </div>
  </div>
  <div class="wrap head__in">
    <a class="logo" href="/" aria-label="Капитал Метт — на главную">
      {logo
        ? <img src={logo} alt="Капитал Метт" height="36" />
        : <><span class="logo__mark" aria-hidden="true"></span><span class="logo__text">Капитал Метт</span></>}
    </a>
    <nav class="nav" aria-label="Основное меню">
      {nav.map((n) => <a href={n.href}>{n.text}</a>)}
    </nav>
    <div class="head__mobile">
      <Chat variant="chip" label={false} />
      <button class="burger" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="drawer" id="drawer" hidden>
    <nav class="wrap drawer__in" aria-label="Меню">
      {nav.map((n) => <a href={n.href}>{n.text}</a>)}
      <button class="btn btn--accent btn--big" type="button" data-open="order">Заказать вывоз</button>
      <a class="drawer__phone" href={site.phone.href} data-goal="phone">{site.phone.text}</a>
      <Chat variant="button" />
      <a class="drawer__channel" href={site.telegram} target="_blank" rel="noopener" data-goal="channel">Telegram-канал с ценами</a>
    </nav>
  </div>
</header>
