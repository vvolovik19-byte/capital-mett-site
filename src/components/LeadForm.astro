---
// Форма заявки. Варианты: call — обратный звонок, order — вывоз, estimate — выезд оценщика (демонтаж),
// rent — аренда техники (машина из fleet.json и дата). goal — доп. цель Метрики, например form-samovyvoz.
import fleet from '../data/fleet.json';
type Variant = 'call' | 'order' | 'estimate' | 'rent';
interface Props { id: string; variant?: Variant; submit: string; goal?: string; service?: string }
const { id, variant = 'call', submit, goal, service } = Astro.props;
const address = { order: 'Адрес объекта', estimate: 'Адрес объекта', rent: 'Адрес подачи' }[variant as string];
const what = { call: 'Что сдаёте (необязательно)', order: 'Что и сколько вывозим', estimate: 'Что нужно демонтировать' }[variant as string];
---
<form class="form" id={id} action="/api/zayavka.php" method="post" data-form={variant} data-form-goal={goal} novalidate>
  <input type="hidden" name="form" value={variant} />
  {service && <input type="hidden" name="service" value={service} />}
  <!-- Ловушка для спам-ботов: поле скрыто от людей, заполнивших его обработчик отбрасывает -->
  <label class="hp" aria-hidden="true">Сайт <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
  <label class="field"><span>Имя</span><input id={`${id}-name`} name="name" type="text" autocomplete="name" /></label>
  <label class="field"><span>Телефон</span><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+7" required /></label>
  {variant === 'rent' && (
    <div class="form__row">
      <label class="field"><span>Машина</span>
        <select id={`${id}-machine`} name="machine">
          {fleet.machines.map((m) => <option value={m.name} data-id={m.id}>{m.name}</option>)}
        </select>
      </label>
      <label class="field"><span>Дата</span><input id={`${id}-date`} name="date" type="date" /></label>
    </div>
  )}
  {address && (
    <label class="field"><span>{address}</span><input id={`${id}-address`} name="address" type="text" autocomplete="street-address" /></label>
  )}
  {what && (
    <label class="field"><span>{what}</span><input id={`${id}-what`} name="what" type="text" /></label>
  )}
  <!-- Согласие — отдельная галочка (ч. 1 ст. 9 152-ФЗ в ред. 156-ФЗ), не отмечена по умолчанию; ссылки в новой вкладке, чтобы не терялись введённые данные -->
  <label class="check"><input id={`${id}-agree`} name="agree" type="checkbox" required /><span>Даю <a href="/soglasie" target="_blank" rel="noopener">согласие на обработку персональных данных</a></span></label>
  <p class="form__msg" role="alert" hidden></p>
  <button class="btn btn--accent btn--big" type="submit">{submit}</button>
  <p class="form__note">Отправляя форму, вы подтверждаете, что ознакомились с <a href="/politika" target="_blank" rel="noopener">Политикой обработки персональных данных</a>.</p>
</form>
