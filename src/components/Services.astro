---
import site from '../data/site.json';
import list from '../data/services.json';
// Первые три карточки берутся из services.json — там же тексты самих страниц услуг.
const services = [
  ...list.map((s) => ({ ...s.card, href: `/uslugi/${s.slug}`, goal: undefined })),
  { n: '04', title: 'Партии для предприятий', href: site.phone.href, more: 'Обсудить партию по телефону', goal: 'phone',
    text: 'Принимаем лом партиями с производств и строек. Договор и безналичная оплата на счёт организации. Цену назовём по телефону.' },
];
interface Props { title?: string; text?: string; tone?: string }
const { title = 'Услуги для компаний', text = 'Забираем лом с объекта, разбираем конструкции и даём технику с водителем.', tone = '' } = Astro.props;
---
<section class:list={['section', tone]} id="uslugi">
  <div class="wrap">
    <header class="section__head" data-reveal>
      <h2>{title}</h2>
      <p>{text}</p>
    </header>
    <ol class="services">
      {services.map((s) => (
        <li class="service" data-reveal>
          <span class="service__n" aria-hidden="true">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a class="service__link" href={s.href} data-goal={s.goal}>{s.more}</a>
        </li>
      ))}
    </ol>
  </div>
</section>
