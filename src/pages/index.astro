---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Yards from '../components/Yards.astro';
import Calculator from '../components/Calculator.astro';
import Sections from '../components/Sections.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Приём металлолома в Москве и МО — цены за кг и тонну | Капитал Метт"
  description="Сдать металлолом, макулатуру и пластик в Москве и Подмосковье: 7 площадок, приём от 1 кг круглосуточно, вывоз с объекта, работа с частными лицами и компаниями."
>
  <Header />
  <main id="main">
    <Hero />
    <Services />
    <Yards />
    <Calculator />
    <Sections />
  </main>
  <Footer />
</Base>
